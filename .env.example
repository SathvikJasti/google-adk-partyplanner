# Copy to .env and fill in. Every service reads this file at startup.

# --- Gemini ---
GOOGLE_API_KEY=your-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Telemetry (standard OTel SDK env vars) ---
# OTel Collector from observability/docker-compose.yml
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=party-planner,deployment.environment=local
OTEL_METRIC_EXPORT_INTERVAL=10000
# Emit the stable HTTP metric names (http.server.request.duration, ...)
OTEL_SEMCONV_STABILITY_OPT_IN=http
# NO_CONTENT | SPAN_ONLY | EVENT_ONLY | SPAN_AND_EVENT. Recording prompts and
# responses on LLM spans is useful for debugging; avoid it in production (PII).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# --- Service ports (each service runs in its own process) ---
PARTY_PLANNER_PORT=8000
BUDGET_AGENT_PORT=8001
MCP_SERVER_PORT=8002
COMPLIANCE_AGENT_PORT=8003

# --- Optional overrides (defaults shown) ---
# BIND_HOST=127.0.0.1
# PUBLIC_HOST=127.0.0.1
# MCP_SERVER_URL=http://127.0.0.1:8002/mcp
# BUDGET_AGENT_URL=http://127.0.0.1:8001
# COMPLIANCE_AGENT_URL=http://127.0.0.1:8003
# A2A_TIMEOUT=120
# MCP_TIMEOUT=10
